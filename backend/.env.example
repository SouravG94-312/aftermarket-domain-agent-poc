# Backend config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
MOCK_MCP=false

# Path to the local MCP server folder, relative to backend/ or absolute
MCP_SERVER_DIR=../mcp_server

# Optional OpenAI reasoning. If missing, backend uses deterministic fallback reasoning.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.5

# Databricks credentials used by the MCP server child process
CATALOG=main
SCHEMA=aftermarket_agent_poc
DATABRICKS_SERVER_HOSTNAME=dbc-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=your-databricks-pat-here

# Optional LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=aftermarket-agent-cluster-poc
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Analytics Agent -> Databricks Genie MCP settings
# Use MOCK_MCP=true for local testing without Databricks.
# Set MOCK_MCP=false and configure these when connecting to a real Databricks Genie MCP endpoint.
GENIE_MCP_SERVER_URL=
GENIE_MCP_TOOL_NAME=
DATABRICKS_CONFIG_PROFILE=DEFAULT
